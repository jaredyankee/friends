# Copy to .env.local and fill in. Never commit a real .env file.
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time. Anything with
# that prefix is readable by anyone who downloads the app — treat it as public.

# Supabase project URL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The ANON key, and only the anon key.
#
# This is safe to ship. It is designed to be public: it identifies the project
# and carries no privileges of its own. Every row it can reach is governed by
# row-level security, which is why the visibility model lives in Postgres rather
# than the client (see CLAUDE.md and docs/schema.md).
#
# The SERVICE ROLE key bypasses RLS entirely. It must never appear in this file,
# in the app bundle, in EXPO_PUBLIC_ anything, or in the repository. It belongs
# only in Supabase Edge Function secrets and CI secrets.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
