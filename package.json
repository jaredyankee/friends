{
  "name": "friends",
  "version": "1.0.0",
  "description": "Easily share your availability with your friends!",
  "keywords": [
    "friends",
    "schedule",
    "calendar",
    "organize"
  ],
  "homepage": "https://github.com/jaredyankee/friends#readme",
  "bugs": {
    "url": "https://github.com/jaredyankee/friends/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaredyankee/friends.git"
  },
  "license": "MIT",
  "author": "jaredyankee",
  "private": true,
  "main": "expo-router/entry",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "react-dom": "19.2.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
